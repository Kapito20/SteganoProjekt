      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Image watermarking,Lifting wavelet transform(LWT),Singular value decomposition(SVD),Support vector machine(SVM),Invariant centroid,Radon transform</pdf:Keywords>
         <pdf:Producer>Acrobat Distiller 9.0.0 (Windows)</pdf:Producer>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:identifier>10.1007/s11042-017-5035-9</dc:identifier>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>Multimedia Tools and Applications</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Multimed Tools Appl, doi:10.1007/s11042-017-5035-9</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Image watermarking</rdf:li>
               <rdf:li>Lifting wavelet transform(LWT)</rdf:li>
               <rdf:li>Singular value decomposition(SVD)</rdf:li>
               <rdf:li>Support vector machine(SVM)</rdf:li>
               <rdf:li>Invariant centroid</rdf:li>
               <rdf:li>Radon transform</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Geometric distortion correction based robust watermarking scheme in LWT-SVD domain with digital watermark extraction using SVM</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Mohiul Islam</rdf:li>
               <rdf:li>Rabul Hussain Laskar</rdf:li>
            </rdf:Seq>
         </dc:creator>
      </rdf:Description>
